<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="hrDashboardMapper">

    <resultMap id="hrMemberResultMap" type="com.kh.blueming.hrdashboard.model.vo.HrDashboardMember">
        <result property="memberId" column="MEMBER_ID"/>
        <result property="name" column="NAME"/>
        <result property="departmentName" column="DEPARTMENT_NAME"/> 
        <result property="positionName" column="POSITION_NAME"/>
        <result property="email" column="EMAIL"/>
        <result property="progressRate" column="PROGRESS_RATE"/>
    </resultMap>

    <resultMap id="hrNoticeResultMap" type="com.kh.blueming.hrdashboard.model.vo.HrDashboardMember">
        <result property="noticeId" column="NOTICE_ID"/>
        <result property="noticeTitle" column="NOTICE_TITLE"/>
        <result property="content" column="CONTENT"/>
        <result property="memberId" column="MEMBER_ID"/>
        <result property="count" column="COUNT"/>
        <result property="createdDate" column="CREATED_DATE"/>
        <result property="updatedDate" column="UPDATED_DATE"/>
        <result property="fileIdNumber" column="FILE_ID"/>
        <result property="Status" column="STATUS"/>
    </resultMap>
	<select id="getMemberProgressList" parameterType="map" resultMap="hrMemberResultMap">
        SELECT * FROM (
            SELECT ROWNUM RNUM, A.* FROM (
                SELECT 
                    m.MEMBER_ID,
                    m.NAME,
                    NVL(m.DEPARTMENT_ID, '소속없음') AS DEPARTMENT_NAME,
                    NVL(m.POSITION_ID, '사원') AS POSITION_NAME,
                    m.EMAIL,
                    ROUND(AVG(p.CHAP_COMP_RATE), 2) AS PROGRESS_RATE
                FROM MEMBER m
                LEFT JOIN COURSE c ON m.MEMBER_ID = c.MEMBER_ID
                LEFT JOIN CHAPTER ch ON c.COURSE_ID = ch.COURSE_ID
                LEFT JOIN CHAPTER_PROGRESS p ON ch.CHAPTER_ID = p.CHAPTER_ID
                WHERE 1=1
                <if test="keyword != null and keyword != ''">
                    AND m.NAME LIKE '%' || #{keyword} || '%'
                </if>
                GROUP BY m.MEMBER_ID, m.NAME, m.DEPARTMENT_ID, m.POSITION_ID, m.EMAIL
                ORDER BY m.NAME ASC
            ) A
        )
        WHERE RNUM BETWEEN #{startRow} AND #{endRow}
    </select>

    <select id="getRecentNoticeList" parameterType="map" resultMap="hrNoticeResultMap">
        SELECT * FROM (
            SELECT ROWNUM RNUM, A.* FROM (
                SELECT 
                    NOTICE_ID,
                    NOTICE_TITLE,
                    CONTENT,
                    MEMBER_ID,
                    COUNT,
                    CREATED_DATE,
                    UPDATED_DATE,
                    FILE_ID,
                    STATUS
                FROM NOTICE
                WHERE STATUS = 'Y'
                ORDER BY CREATED_DATE DESC
            ) A
        )
        WHERE RNUM BETWEEN #{startRow} AND #{endRow}
    </select>
    <select id="getMemberCount" parameterType="string" resultType="_int">
        SELECT COUNT(*)
        FROM MEMBER
        WHERE 1=1
        <if test="_parameter != null and _parameter != ''">
            AND NAME LIKE '%' || #{value} || '%'
        </if>
    </select>

    

    <select id="getNoticeCount" resultType="_int">
        SELECT COUNT(*) FROM NOTICE WHERE STATUS = 'Y'
    </select>

    

</mapper>