<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="adminDashboardMapper">

<resultMap id="noticeResultSet" type="notice">
		<id column="NOTICE_ID" property="noticeId" />
		<result column="NOTICE_TITLE" property="noticeTitle" />
		<result column="CONTENT" property="content" />
		<result column="MEMBER_ID" property="memberId" />
		<result column="COUNT" property="count" />
		<result column="CREATED_DATE" property="createdDate" />
		<result column="UPDATED_DATE" property="updateDate" />
		<result column="FILE_ID" property="fileIdNumber" />
		<result column="STATUS" property="Status" />
</resultMap>
	
	<!-- 관리자 대시보드 강의 목록 조회 -->
    <select id="selectAdminCourseList" parameterType="map" resultType="adminDashboardCourse">
        SELECT C.COURSE_ID AS courseId,
               C.COURSE_TITLE AS courseTitle,
               C.START_DATE AS startDate,
               C.END_DATE AS endDate,
               CEIL(C.END_DATE - SYSDATE) AS dDay,
               CASE
                   WHEN C.END_DATE &lt; SYSDATE THEN 'CLOSED'
                   WHEN C.STATUS = 'W' THEN 'WAITING'
                   ELSE 'IN_PROGRESS'
               END AS courseStatus
        FROM COURSE C
        WHERE C.STATUS != 'N'
        ORDER BY C.CREATE_DATE DESC
    </select>
    
        <!-- 최근 공지사항 3개 조회 -->
	<select id="selectRecentNoticeList" resultMap="noticeResultSet">
    SELECT NOTICE_ID,
	           NOTICE_TITLE,
	           CREATED_DATE
	    FROM (
	        SELECT NOTICE_ID,
	               NOTICE_TITLE,
	               CREATED_DATE
	        FROM NOTICE
	        WHERE STATUS = 'Y'
	        ORDER BY CREATED_DATE DESC
	    )
	    WHERE ROWNUM &lt;= 3
	</select>
	
</mapper>